# Copy to .env and fill in once the Supabase project exists.
# .env is gitignored — set these same variables in the Vercel dashboard
# (Project Settings → Environment Variables) so production builds pick them up.

# Public site URL, no trailing slash. Used for canonical URLs, Open Graph /
# Twitter tags, the JSON-LD schema, and the generated sitemap/robots.txt.
VITE_SITE_URL=https://PLACEHOLDER-DOMAIN.tld

# Supabase project credentials (Project Settings → API in the Supabase dashboard).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Meta + TikTok pixels are now admin-managed (DB-driven) — the owner adds ids in
# /admin/pixels, no env var and no redeploy. See supabase/migrations 0015.
